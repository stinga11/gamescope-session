#!/bin/bash
set -e

# Verificar que plasmalogin esté activo antes de hacer nada
if ! systemctl is-active --quiet plasmalogin.service; then
    echo "plasmalogin.service no está activo, abortando." >&2
    exit 1
fi

# Determinar el usuario de forma robusta, sin depender de hardcoding
USER_NAME="${PLASMALOGINUSER:-${SUDO_USER:-$(logname 2>/dev/null || whoami)}}"
: "${USER_NAME:?No se pudo determinar el usuario}"

CONF_FILE="/etc/plasmalogin.conf"

# Session, gamescope or plasma
SESSION="${1:-gamescope-session.desktop}"

# Modify only the Session parameter while keeping the rest of the file intact
if grep -q "^\[Autologin\]" "$CONF_FILE" 2>/dev/null; then
    sed -i "s/^Session=.*/Session=$SESSION/" "$CONF_FILE"
else
    cat >> "$CONF_FILE" << EOF2

[Autologin]
User=${USER_NAME}
Session=$SESSION
Relogin=true
EOF2
fi
